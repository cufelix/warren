{
  "name": "warren",
  "private": true,
  "type": "module",
  "workspaces": [
    "hub",
    "bridge",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w hub",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w bridge",
    "e2e": "tsx e2e/run.ts",
    "typecheck": "tsc -p hub && tsc -p bridge",
    "test": "node --import tsx --test --test-reporter=spec \"hub/test/*.test.ts\" \"bridge/test/*.test.ts\"",
    "team": "WARREN_DEMO=0 WARREN_TEAM=${WARREN_TEAM:-junction} tsx hub/src/server.ts",
    "devices": "tsx e2e/devices/run.ts",
    "vms": "tsx e2e/vms/run.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
